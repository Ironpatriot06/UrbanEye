# UrbanEye+ Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Full SQLAlchemy connection string for the PostgreSQL/PostGIS database.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://urbaneye:urbaneye_dev@localhost:5432/urbaneye

# ---------------------------------------------------------------------------
# API / Security
# ---------------------------------------------------------------------------
# A long random string used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Google Sign-In (OAuth 2.0 / OpenID Connect)
# ---------------------------------------------------------------------------
# PLACEHOLDERS ONLY — never commit real credentials.
#
# Create them at https://console.cloud.google.com/apis/credentials
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: http://localhost:8000/api/v1/auth/google/callback
#
# Leave both blank to run without Google sign-in: the login page then shows
# only email/password, and the Google endpoints return HTTP 503.
# Full walkthrough: docs/authentication.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client EXACTLY, including
# scheme, port and path.  This points at the BACKEND: the authorization code is
# exchanged server-side so GOOGLE_CLIENT_SECRET never reaches the browser.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Where the backend sends the browser after Google sign-in completes, and the
# only origin a post-login redirect is allowed to target.
FRONTEND_URL=http://localhost:3000

# Lifetime of the OAuth `state` (CSRF) token, in seconds.
OAUTH_STATE_EXPIRE_SECONDS=600

# Set the Secure flag on the OAuth state cookie.  MUST be true wherever the app
# is served over HTTPS; false locally, because http://localhost would drop it.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Demo accounts (used by scripts/create_demo_data.py)
# Change these before running in any non-local environment.
# ---------------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@urbaneye.local
DEMO_ADMIN_PASSWORD=Admin@1234
DEMO_ADMIN_NAME=System Admin

DEMO_AGENT_EMAIL=agent@urbaneye.local
DEMO_AGENT_PASSWORD=Agent@1234
DEMO_AGENT_NAME=Field Agent

DEMO_AGENT_EMAIL_2=agent2@urbaneye.local
DEMO_AGENT_PASSWORD_2=Agent2@1234
DEMO_AGENT_NAME_2=Field Agent 2

DEMO_USER_EMAIL=user@urbaneye.local
DEMO_USER_PASSWORD=User@1234
DEMO_USER_NAME=Demo Citizen

# ---------------------------------------------------------------------------
# Future integrations (not yet used – listed here for discoverability)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# ML predictions (Phase 2C) — all optional; the defaults work from a clone.
# ---------------------------------------------------------------------------
# Master switch. false -> every prediction is UNAVAILABLE (ML_DISABLED) and no
# model file is opened; incident workflows are unaffected.
# ML_ENABLED=true
# Versioned model bundle (committed under backend/ml_bundle/). Change only
# together with ML_BUNDLE_MANIFEST_SHA256 — the backend refuses a bundle whose
# MANIFEST.json hash differs from the pinned value.
# ML_BUNDLE_DIR=/absolute/path/to/backend/ml_bundle/urbaneye-ml-2026.10.13
# ML_BUNDLE_MANIFEST_SHA256=<sha256 of MANIFEST.json>
# Service areas (JSON list of {name, lat_min, lat_max, lon_min, lon_max}).
# Empty -> built-in Bengaluru and Chennai boxes.
# ML_SERVICE_AREAS=
# Log predictions automatically when an incident is created or its SLA /
# priority changes (best effort; never blocks the write).
# ML_LOG_ON_WRITE=true
