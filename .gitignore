# ML models
*.pt
*.pth
*.onnx
/models/
/datasets/

# UrbanEye ML pipeline data — datasets stay on disk, never in Git.
# '/**' (not '/*') so files at every depth are ignored; the '!**/' rule
# re-includes the directories themselves so Git still descends into them
# and the .gitkeep structure markers survive.
# data/manifests/ is deliberately NOT ignored: those files record the
# source URL, checksum and row count of each download — provenance, not data.
UrbanEye_ML_Data_Pipeline/data/raw/**
UrbanEye_ML_Data_Pipeline/data/processed/**

# Keep directory structure
!UrbanEye_ML_Data_Pipeline/data/raw/**/
!UrbanEye_ML_Data_Pipeline/data/raw/**/.gitkeep
!UrbanEye_ML_Data_Pipeline/data/processed/**/
!UrbanEye_ML_Data_Pipeline/data/processed/**/.gitkeep

# Trained model artifacts and experiment scratch. Same policy as data/: these
# are regenerated by `python scripts/train/run_all.py` and must not be tracked.
# The '/models/' rule above is anchored to the repo root and does not cover the
# pipeline's own directory, so it is spelled out here.
UrbanEye_ML_Data_Pipeline/models/**
UrbanEye_ML_Data_Pipeline/experiments/**
!UrbanEye_ML_Data_Pipeline/models/**/
!UrbanEye_ML_Data_Pipeline/models/**/.gitkeep
!UrbanEye_ML_Data_Pipeline/experiments/**/
!UrbanEye_ML_Data_Pipeline/experiments/**/.gitkeep

# OS
.DS_Store

